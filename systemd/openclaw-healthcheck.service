[Unit]
Description=OpenClaw codex pool healthcheck
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rdpuser
EnvironmentFile=-/etc/openclaw-healthcheck.env
ExecStart=/usr/bin/bash -lc '${OCX_BASE_DIR:-/data/openclaw}/scripts/healthcheck_openai_codex_pool.sh'
SuccessExitStatus=1 2

[Install]
WantedBy=multi-user.target
