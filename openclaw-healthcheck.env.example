# Copy to /etc/openclaw-healthcheck.env and edit as needed

# Base directory for scripts/reports
OCX_BASE_DIR=/data/openclaw

# Provider settings
OCX_PROVIDER=openai-codex
OCX_PROFILE_PREFIX=openai-codex:
OCX_MIN_PROFILES=1
OCX_RECOMMENDED_MIN=1
OCX_RECOMMENDED_MAX=12
OCX_EXPIRING_HOURS=24

# Notification
OCX_NOTIFY_CHANNEL=telegram
OCX_NOTIFY_TARGET=182211955

# Runtime
OCX_AGENT_TIMEOUT_SECONDS=45
# OCX_CODEX_AUTH_PATH=/root/.codex/auth.json
# OCX_AUTH_PROFILES_PATH=/root/.openclaw/agents/main/agent/auth-profiles.json
OCX_LOG_RETENTION_DAYS=30

# Alert policy
OCX_ALERT_BURST_COUNT=3
OCX_ALERT_REMIND_SECONDS=3600
OCX_ALERT_DEDUP_SECONDS=900
# OCX_ALERT_STATE_FILE=/data/openclaw/run/openai_codex_alert_state.json

# Circuit breaker + pool state
OCX_CB_FAIL_THRESHOLD=3
OCX_CB_COOLDOWN_SECONDS=3600
# OCX_POOL_STATE_FILE=/data/openclaw/run/openai_codex_pool_state.json

# Strategy
# OCX_AUTO_REORDER=1
# OCX_AUTO_REORDER_ACCOUNT_DIVERSITY=1   # 1=重排时按 accountId 交错，尽量避免同账号连续
# OCX_PROBE_HINT_DEMOTE_WITHOUT_AUTO_REORDER=1  # 1=当探针出现 connected|error/auth/quota 信号时，AUTO_REORDER=0 也会把疑似故障账号降到队尾
# OCX_DISABLE_PROBES=0                    # 生产建议保持 0；设为 1 会失去 usage-limit/token-invalidated 的快速切换能力

# Probe-signal emergency breaker (for "usage limit" / "token invalidated" style failures)
# OCX_PROBE_HINT_FORCE_TRIP=1
# OCX_PROBE_HINT_MIN_COOLDOWN_SECONDS=1800
# OCX_PROBE_HINT_MAX_COOLDOWN_SECONDS=259200

# v2 hard isolation + controlled recovery
# OCX_HARD_DISABLE_FAILED=1              # 1=仅把 active 池下发到 auth order，失败/隔离账号不参与轮换
# OCX_HARD_DISABLE_FAILED_ACCOUNT=1      # 1=某 profile 失败时，按 accountId 隔离同账号全部 profiles
# OCX_ACCOUNT_QUARANTINE_SECONDS=7200    # 同账号隔离时长（秒）
# OCX_RECOVERY_SUCCESS_ROUNDS=2          # 恢复门槛：连续 N 轮健康才放回 active 池
# OCX_HARD_DISABLE_MIN_ACTIVE_PROFILES=2 # active profile 低于阈值时 fail-open
# OCX_HARD_DISABLE_MIN_ACTIVE_ACCOUNTS=1 # active account 低于阈值时 fail-open
# OCX_MAX_PROFILES_PER_ACCOUNT_IN_ORDER=2 # 每个 accountId 在最终轮换队列中的最大 profile 数（0=关闭）
# OCX_ACCOUNT_CAP_FAIL_OPEN_MIN_PROFILES=2 # 应用上面硬限制后低于该值则回退到原始队列

# Repair policy
# OCX_AUTO_REPAIR=1
OCX_REPAIR_MIN_INTERVAL_SECONDS=1800
# OCX_AUTH_MAP_FILE=/data/openclaw/config/openai-codex-auth-map.env
# OCX_REPAIR_NOTIFY=1
# OCX_REPAIR_RESTART_GATEWAY=0
# OCX_SUGGEST_DECOMMISSION=0   # 1=在修复建议里附带“删除并替换”命令

# Proxy fallback resilience
# OCX_PROXY_AUTO_FALLBACK=1
# OCX_PROXY_FALLBACK_MAX_ATTEMPTS=6
# OCX_PROXY_FALLBACK_BACKOFF_SECONDS=2
# OCX_PROXY_FALLBACK_PERSIST_MAP=1

# Proxy quarantine (avoid repeatedly using known-bad proxies)
# OCX_PROXY_QUARANTINE_FILE=/data/openclaw/run/proxy-quarantine.tsv
# OCX_PROXY_QUARANTINE_SECONDS=1800
# OCX_PROXY_QUARANTINE_SECONDS_STRICT=3600
# OCX_PROXY_QUARANTINE_SECONDS_SOFT=900

# Debug
# OCX_DRY_RUN=1

# OCX_CB_FAIL_THRESHOLD_AUTH=3
# OCX_CB_FAIL_THRESHOLD_NETWORK=5
# OCX_CB_FAIL_THRESHOLD_OTHER=5
# OCX_CB_COOLDOWN_SECONDS_AUTH=3600
# OCX_CB_COOLDOWN_SECONDS_NETWORK=600
# OCX_CB_COOLDOWN_SECONDS_OTHER=900
# OCX_CB_HALF_OPEN_WINDOW_SECONDS=300
# OCX_CB_FAIL_THRESHOLD_DEFAULT=4
# OCX_CB_COOLDOWN_SECONDS_DEFAULT=1800
# OCX_CB_COOLDOWN_JITTER_MIN_SECONDS=30
# OCX_CB_COOLDOWN_JITTER_MAX_SECONDS=120
# OCX_CB_FAILCOUNT_DECAY_ENABLED=1
# OCX_CB_FAILCOUNT_DECAY_INTERVAL_SECONDS=1800
