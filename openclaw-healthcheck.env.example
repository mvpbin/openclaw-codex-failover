# Copy to /etc/openclaw-healthcheck.env and edit as needed

# Base directory for scripts/reports
OCX_BASE_DIR=/data/openclaw

# Provider settings
OCX_PROVIDER=openai-codex
OCX_PROFILE_PREFIX=openai-codex:
OCX_MIN_PROFILES=1
OCX_RECOMMENDED_MIN=5
OCX_RECOMMENDED_MAX=12
OCX_EXPIRING_HOURS=24

# Notification
OCX_NOTIFY_CHANNEL=telegram
OCX_NOTIFY_TARGET=182211955

# Runtime
OCX_AGENT_TIMEOUT_SECONDS=45
OCX_LOG_RETENTION_DAYS=30

# Alert policy
OCX_ALERT_BURST_COUNT=3
OCX_ALERT_REMIND_SECONDS=3600
# OCX_ALERT_STATE_FILE=/data/openclaw/run/openai_codex_alert_state.json

# Repair policy
# OCX_AUTO_REPAIR=1
# OCX_AUTH_MAP_FILE=/data/openclaw/config/openai-codex-auth-map.env
# OCX_REPAIR_NOTIFY=1
# OCX_REPAIR_RESTART_GATEWAY=0

# Debug
# OCX_DRY_RUN=1
