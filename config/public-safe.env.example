# Public-safe starter template (no real secrets)
# Copy to /etc/openclaw-healthcheck.env and replace placeholders.

OCX_BASE_DIR=/data/openclaw

# Provider
OCX_PROVIDER=openai-codex
OCX_PROFILE_PREFIX=openai-codex:
OCX_MIN_PROFILES=1
OCX_RECOMMENDED_MIN=1
OCX_RECOMMENDED_MAX=12
OCX_EXPIRING_HOURS=24

# Notification (REQUIRED: replace target)
OCX_NOTIFY_CHANNEL=telegram
OCX_NOTIFY_TARGET=REPLACE_ME

# Runtime
OCX_AGENT_TIMEOUT_SECONDS=45
OCX_LOG_RETENTION_DAYS=30

# Alert policy
OCX_ALERT_BURST_COUNT=3
OCX_ALERT_REMIND_SECONDS=3600
OCX_ALERT_DEDUP_SECONDS=900

# Circuit breaker
OCX_CB_FAIL_THRESHOLD=3
OCX_CB_COOLDOWN_SECONDS=3600

# Repair cadence
OCX_REPAIR_MIN_INTERVAL_SECONDS=1800

# Proxy resilience (optional defaults)
OCX_PROXY_AUTO_FALLBACK=1
OCX_PROXY_FALLBACK_MAX_ATTEMPTS=6
OCX_PROXY_FALLBACK_BACKOFF_SECONDS=2
OCX_PROXY_FALLBACK_PERSIST_MAP=1

# Proxy quarantine
OCX_PROXY_QUARANTINE_SECONDS=1800
OCX_PROXY_QUARANTINE_SECONDS_STRICT=3600
OCX_PROXY_QUARANTINE_SECONDS_SOFT=900

# Safety switch for first run (recommended):
# OCX_DRY_RUN=1
